# Local development values. Use new, strong passwords for any shared environment.
MYSQL_PORT=3306
MYSQL_PASSWORD=fridge_dev_password
MYSQL_ROOT_PASSWORD=fridge_dev_root_password

DB_URL=jdbc:mysql://localhost:3306/fridge_gatekeeper?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=fridge_app
DB_PASSWORD=fridge_dev_password

# The Spring Boot process reads environment variables; Docker Compose reads .env.
# Keep the OpenAI key on the server. Never add it to VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
